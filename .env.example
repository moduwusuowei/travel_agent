# travel_agent 环境配置模板
# 用法：复制本文件为 .env 并填入真实值（.env 已在 .gitignore 中，不会被提交）

# —— 必填 ——
# API Key：官方 Anthropic key 或 Claude 兼容代理的 token，二者填其一
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx
# ANTHROPIC_AUTH_TOKEN=xxxxxxxxxxxxxxxxx

# API 地址（必填）：官方为 https://api.anthropic.com ，走代理则填代理地址
ANTHROPIC_BASE_URL=https://api.anthropic.com

# —— 可选 ——
# 覆盖默认模型（默认 claude-opus-4-8）
# VERIFY_MODEL=claude-opus-4-8

# 调试开关：设置后流式异常打印完整堆栈
# TRAVEL_DEBUG=1
